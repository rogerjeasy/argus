ENVIRONMENT=local
GCP_PROJECT_ID=argus-local-dev
FIREBASE_PROJECT_ID=argus-local-dev
VERTEX_AI_LOCATION=us-central1
GEMINI_LIVE_MODEL=gemini-live-2.5-flash
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
# Local Firestore emulator (optional): run `gcloud emulators firestore start`
# then export FIRESTORE_EMULATOR_HOST=localhost:8080 before `make dev`.
# Switzerland — opentransportdata.swiss. Free token via their API Manager:
# https://api-manager.opentransportdata.swiss/. Leave blank to run MBTA-only.
GTFS_CH_STATIC_FEED_URL=
GTFS_CH_REALTIME_FEED_URL=
GTFS_CH_AUTH_TOKEN=
# MBTA (Boston) — public, keyless. Defaults already point at the real feed.
GTFS_MBTA_STATIC_FEED_URL=https://cdn.mbta.com/MBTA_GTFS.zip
GTFS_MBTA_REALTIME_FEED_URL=https://cdn.mbta.com/realtime/TripUpdates.pb
GTFS_REALTIME_CACHE_TTL_SECONDS=5.0
# Cloud KMS key for encrypting Personal Admin's medical/financial profile
# fields. Leave blank for local dev — fields are stored as plaintext then,
# never a crash.
KMS_KEY_NAME=
