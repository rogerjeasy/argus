ENVIRONMENT=local
GCP_PROJECT_ID=argus-local-dev
FIREBASE_PROJECT_ID=argus-local-dev
VERTEX_AI_LOCATION=us-central1
GEMINI_LIVE_MODEL=gemini-live-2.5-flash
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
# Local Firestore emulator (optional): run `gcloud emulators firestore start`
# then export FIRESTORE_EMULATOR_HOST=localhost:8080 before `make dev`.
# Switzerland — opentransportdata.swiss. Free token via their API Manager:
# https://api-manager.opentransportdata.swiss/. Leave blank to run MBTA-only.
GTFS_CH_STATIC_FEED_URL=
GTFS_CH_REALTIME_FEED_URL=
GTFS_CH_AUTH_TOKEN=
# MBTA (Boston) — public, keyless. Defaults already point at the real feed.
GTFS_MBTA_STATIC_FEED_URL=https://cdn.mbta.com/MBTA_GTFS.zip
GTFS_MBTA_REALTIME_FEED_URL=https://cdn.mbta.com/realtime/TripUpdates.pb
GTFS_REALTIME_CACHE_TTL_SECONDS=5.0
# Cloud KMS key for encrypting Personal Admin's medical/financial profile
# fields. Leave blank for local dev — fields are stored as plaintext then,
# never a crash.
KMS_KEY_NAME=
# Twilio Voice — real outbound PSTN calls for the Call Agent. Leave every
# value below blank until you have a real account; CallExecutor and its
# tests run entirely against FakeTwilioClient until then. See design doc §3.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# A second, self-controlled Twilio number scripted as a fake IVR — the
# repeatable test fixture from master spec §16, not a real business's line.
TWILIO_TEST_IVR_NUMBER=
# e.g. https://argus-xyz.a.run.app, or an ngrok URL for local dev against a
# real Twilio account.
PUBLIC_BASE_URL=
CLOUD_TASKS_QUEUE=argus-call-retries
# Cloud Storage bucket for Form-Filling Agent's generated PDF receipts.
# Empty means "not provisioned yet" — build_orchestrator only registers
# FormExecutor when this is set (see infra/terraform/modules/storage_bucket).
PERSONAL_ADMIN_STORAGE_BUCKET=
CLOUD_TASKS_LOCATION=us-central1
